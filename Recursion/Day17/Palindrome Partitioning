/*
  Problem: Palindrome Partitioning
  Link: https://leetcode.com/problems/palindrome-partitioning/

  Approach:
  - Optimal (implemented) — Recursion:
      At each index, try all substrings starting from idx.
      If substring is a palindrome (two-pointer check), add to temp and recurse.
      When idx reaches s.size(), push the current partition to ans.
      Backtrack by popping temp after each recursive call.

  Time: O(2^N * N)  Space: O(N) stack depth
*/

class Solution {
public:
    bool isPalindrome(string s) {
        int p1 = 0, p2 = s.size() - 1;
        while (p1 < p2) {
            if (s[p1] != s[p2]) return false;
            p1++; p2--;
        }
        return true;
    }

    void solve(vector<vector<string>>& ans, vector<string>& temp, string& s, int idx) {
        if (idx == s.size()) {
            ans.push_back(temp);
            return;
        }
        string pal_str;
        for (int i = idx; i < s.size(); i++) {
            pal_str += s[i];
            if (isPalindrome(pal_str)) {
                temp.push_back(pal_str);
                solve(ans, temp, s, i + 1);
                temp.pop_back();
            }
        }
    }

    vector<vector<string>> partition(string s) {
        vector<vector<string>> ans;
        vector<string> temp;
        solve(ans, temp, s, 0);
        return ans;
    }
};
